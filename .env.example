# Shared
PORT=8080
VUTAME_MARKETING_ORIGIN=https://vutame.com
VUTAME_PROFILE_ORIGIN=https://vuta.me

# Local persisted development (apply the Atlas local schema first)
VUTAME_DATABASE_DSN=file:vutame.db
VUTAME_AUTH_SECRET=replace-with-at-least-32-random-bytes
VUTAME_COOKIE_SECURE=0
VUTAME_AUTH_LOG_CODES=1

# Hosted production: use these instead of VUTAME_DATABASE_DSN.
# VUTAME_ENV=production
# VUTAME_TURSO_REMOTE_URL=https://database.region.turso.io
# VUTAME_TURSO_AUTH_TOKEN=replace-me
# VUTAME_TURSO_LOCAL_PATH=/tmp/vutame.db
# VUTAME_TURSO_SYNC_INTERVAL=5s
# VUTAME_COOKIE_SECURE=1
# VUTAME_SMTP_ADDR=smtp.example.com:587
# VUTAME_SMTP_USERNAME=replace-me
# VUTAME_SMTP_PASSWORD=replace-me
# VUTAME_AUTH_EMAIL_FROM=Vutame <login@vutame.com>

# Atlas production schema URL. Keep this in deployment secrets rather than a
# committed .env file because the auth token is part of the URL.
# VUTAME_ATLAS_URL=libsql://database.region.turso.io?authToken=replace-me
